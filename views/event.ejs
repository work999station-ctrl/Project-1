<body>

<h2>Create New Event</h2>

<form>

    <label>Title</label>
    <input type="text" name="title" required>

    <label>Description</label>
    <textarea minlength="30" name="description" required></textarea>

    <label>Start Date</label>
    <input type="date" name="startDate" required>

    <label>End Date</label>
    <input type="date" name="endDate" required>

    <label>Place</label>
    <input type="text" name="place" required>

    <label>Theme</label>
    <input type="text" name="theme" required>

    <label>Contact Email</label>
    <input type="email" name="contact" required>

    <h3 class="scientific">Scientific Committee</h3>

    <div id="committeeContainer">
        <div class="committee">
            <label>Name</label>
            <input type="text" class="committeeName">
        </div>
    </div>
    <button type="button" onclick="addCommittee()">+ Add Member</button>

    <button >Create Event</button>
</form>

<script>

   
    function addCommittee() {
    const div = document.createElement('div');
    div.classList.add('committee');
    div.innerHTML = `
        <label>Name</label>
        <input type="text" class="committeeName" >
    `;
    document.getElementById('committeeContainer').appendChild(div);
 
}

    const form = document.querySelector('form');
    // const SC = [];
    // const v = document.querySelectorAll('form #committeeContainer committeeName');
    form.addEventListener( 'submit' , async (e) => {
    e.preventDefault();


        const title = form.title.value ;
        const description = form.description.value ;
        const startDate = form.startDate.value ;
        const endDate = form.endDate.value ;
        const place = form.place.value ;
        const theme = form.theme.value ;
        const contact = form.contact.value ;
        // const committeeInputs = document.querySelectorAll(
        // '#committeeContainer input[name="committeeName"]'
        // );

        // const scientificCommittee = [];
        // committeeInputs.forEach(input => {
        // if (input.value.trim() !== '') {
        // scientificCommittee.push({ name: input.value.trim() });
        // }
        // });


        const scientificCommittee = [];

       document.querySelectorAll('.committeeName').forEach(input => {
       if (input.value.trim() !== '') {
       scientificCommittee.push({ name: input.value.trim() });
      }
     });
        
        


        try{
           const res = await fetch('/event' , {
            method : 'POST',
            body: JSON.stringify({title , description , startDate , endDate , place , theme , contact , scientificCommittee}),
            headers: {'Content-Type' : 'application/json'}
           });
           const data = await res.json();
           console.log( 'data'  + data);
           if(data.errors){
            console.log(data.errors);
           }
            location.assign('/');
        }
        catch(err){
            console.log(err);
        }
    })
